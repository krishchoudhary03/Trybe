# TRYBE AI (optional). Without a key every career feature still works using the
# built-in rules-based engine; the key only enables AI-written explanations.
#
# Groq API Key (Primary AI provider for ultra-fast multi-turn Career Copilot)
# Server-side only — no VITE_ prefix, so it is never bundled into the browser build.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Fallback Google Gemini (optional)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Only needed when the static site is deployed (e.g. GitHub Pages) and the AI proxy
# runs elsewhere. Browser-visible, so it must NOT contain a secret.
# VITE_AI_ENDPOINT=https://your-ai-proxy.example.com/api/ai
